#include "exti.h"

#define GPIOCEN   		(1U<<2) // Enable clock for GPIOC
#define SYSCFGEN		(1U<<14)
#define SYSCFG_EXTICR4

void pc_13_exti_init(void){
	/*Disable global interrupt*/
	__disable_irq();

	/*Enable Clock access to GPIOC*/
	RCC->AHB1ENR |= GPIOCEN;

	/*Enable clock access for SYSCFGEN module which EXTI is part of*/
	RCC->APB2ENR |= SYSCFGEN;

	/*Explicitly making port 13 input*/
	GPIOC->MODER &= ~(3<<26);

	/*Select PORTC for EXTI13*/
	SYSCFG->EXTICR[3] &= ~(0xF<<4); //clearing
	SYSCFG->EXTICR[3] &= ~(0x2<<4); //Setting port C

	/*Un-mask the EXTI from IMR*/
	EXTI->IMR |= (1U<<13);

	/*Set Falling edge trigger*/
	EXTI->FTSR |= (1U<<13);

	/*Enable EXTI line in NVIC*/
	NVIC_EnableIRQ(EXTI15_10_IRQn);

	/*Enable global interrupt*/
	__enable_irq();
}
